# Serves the built site. Paths that belong to the Ludexis app (for links that predate the move) are sent to
# APP_URL with a 308, which keeps the method, so an edge device that still posts here keeps working.
:80 {
	root * /srv
	encode zstd gzip

	@app {
		path /auth/* /account /account/* /admin /admin/* /archive/* /library /library/* /favourites /favourites/*
		path /collections /collections/* /developers /developers/* /publishers /publishers/* /franchises /franchises/*
		path /tags /tags/* /api/* /media/* /healthz
		expression {env.APP_URL} != ""
	}
	redir @app {$APP_URL}{uri} 308

	# Built assets have content hashes in their names.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server {
			status 404
		}
	}
}
