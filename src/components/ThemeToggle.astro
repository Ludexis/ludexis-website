---
import { Icon } from '@astrojs/starlight/components';
---

{/* The same sun and moon switch as the homepage, in place of Starlight's dark/light/auto menu. */}
<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
	<Icon name="sun" class="sun" />
	<Icon name="moon" class="moon" />
</button>

<style>
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		font-size: 1.1rem;
		cursor: pointer;
	}
	.theme-toggle:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.moon,
	:global([data-theme='light']) .sun {
		display: none;
	}
	:global([data-theme='light']) .moon {
		display: block;
	}
</style>

<script>
	const root = document.documentElement;
	const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
	const label = () => {
		const next = root.dataset.theme === 'light' ? 'dark' : 'light';
		toggles.forEach((toggle) => toggle.setAttribute('aria-label', `Switch to ${next} theme`));
	};
	label();
	toggles.forEach((toggle) =>
		toggle.addEventListener('click', () => {
			root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
			try {
				localStorage.setItem('starlight-theme', root.dataset.theme);
			} catch {}
			label();
		}),
	);
</script>
